{
    "name": "signdocs-brasil/signdocs-brasil-php",
    "description": "SDK oficial em PHP para a API SignDocs Brasil: assinatura eletrônica e digital com ICP-Brasil, biometria, OTP e trilha de evidências (Brazilian e-signature API SDK)",
    "type": "library",
    "version": "2.1.0",
    "license": "MIT",
    "keywords": [
        "signdocs",
        "signdocs-brasil",
        "assinatura",
        "assinatura-digital",
        "assinatura-eletronica",
        "assinatura-de-documentos",
        "assinador",
        "certificado-digital",
        "icp-brasil",
        "biometria",
        "digital-signature",
        "electronic-signature",
        "e-signature",
        "esignature",
        "document-signing",
        "brasil",
        "brazil",
        "pkcs7"
    ],
    "homepage": "https://signdocs.com.br",
    "support": {
        "issues": "https://github.com/signdocsbrasil/signdocs-brasil-php/issues",
        "source": "https://github.com/signdocsbrasil/signdocs-brasil-php",
        "docs": "https://docs.signdocs.com.br"
    },
    "authors": [
        {
            "name": "SignDocsBrasil",
            "email": "dev@signdocs.com.br"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0",
        "firebase/php-jwt": "^6.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "SignDocsBrasil\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SignDocsBrasil\\Api\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "audit": {
            "abandoned": "report",
            "block-insecure": false
        }
    }
}
